# Postgres. Local: docker compose up -d. Producción: cadena "pooled" de Neon.
DATABASE_URL=postgres://cut:cut@localhost:5433/cut
# Opcional: conexiones por instancia (5 por defecto). Usa 1 con Postgres embebidos como PGlite.
# DATABASE_POOL_MAX=1

# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app (sin / al final). En Vercel es opcional: si falta, se usa
# el dominio de producción del proyecto. Defínela cuando conectes un dominio propio.
BETTER_AUTH_URL=http://localhost:3000

# Correos (recuperar contraseña) con Resend. El dominio de EMAIL_FROM debe estar verificado en Resend.
# Sin ellos, en producción no aparece "¿Olvidaste tu contraseña?"; en desarrollo el correo se imprime en la terminal.
RESEND_API_KEY=
EMAIL_FROM="cut. <no-reply@cut.lat>"

# Opcional: revisa cada link nuevo contra Google Safe Browsing (phishing y malware).
GOOGLE_SAFE_BROWSING_KEY=
# Opcional: dominios bloqueados, separados por comas. Incluye sus subdominios y también
# desactiva los links que ya existían hacia ellos.
BLOCKED_DOMAINS=

# Opcionales: si no se definen, ese botón de login no aparece.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos de quienes moderan, separados por comas. Reciben los avisos de reportes y de
# solicitudes de cuenta ilimitada, y entran a /admin.
ADMIN_EMAILS=

# Opcional: links que puede crear una cuenta normal (panel y API juntos). Las cuentas
# ilimitadas, que se asignan en /admin → Cuentas, no tienen tope.
# LINKS_PER_HOUR=300
# LINKS_PER_DAY=3000
